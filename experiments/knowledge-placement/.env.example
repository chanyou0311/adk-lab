# Vertex AI 経由で Gemini を叩くための設定。ローカルは ADC (gcloud auth application-default login) 前提。
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=<your-gcp-project>
# gemini-3-flash-preview は Vertex の global エンドポイント限定 (regional は 404)。
# モデル推論だけを global に向けるため location はコード側 (_GlobalGemini) で固定する。
# GOOGLE_CLOUD_LOCATION は Vertex の他リソース用途にのみ効く (本実験では未使用)。
GOOGLE_CLOUD_LOCATION=us-central1
